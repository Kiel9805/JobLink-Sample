# Copy to .env and fill in. See docs/setup-keys.md. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: live job openings from Jooble. Leave blank to show companies only.
JOOBLE_API_KEY=
# Leave blank to run without the Places cache. Example: postgres://postgres:YOUR_PASSWORD@localhost:5432/joblink
DATABASE_URL=
PORT=3000
# Set to 1 only when hosted behind one proxy (e.g. Render), so rate limiting sees real visitor IPs.
TRUST_PROXY=
